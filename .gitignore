# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets / env — solo .env.example debe estar en el repo.
.env
.env.*
!.env.example

# Credenciales locales que algunos editores generan automáticamente.
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

vitest.config.ts.timestamp-*.mjs
vite.config.ts.timestamp-*.mjs

# Stale build artifacts from older configurations (use dist/).
dist2/

# Playwright output (regenerated on every e2e run).
test-results/
playwright-report/

# Legacy / backup copies of the project — retained in git history only.
_legacy_v1_original/
_rebuild_backup/

# Impeccable skills — installed from pbakaus/impeccable via `npx skills add`.
# Regenerable from skills-lock.json, no need to vendor the SKILL.md files.
.agents/
.claude/
.gstack/
coverage
coverage-*/

# Reporte del refresh de clasificación de proveedores (scripts/refresh-provider-classification.mjs).
scripts/out/
