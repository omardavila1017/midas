# FlowSense Environment Configuration
# Copy this file to .env.local and update with your values

# API Configuration (if needed in the future)
VITE_API_URL=http://localhost:3000

# Application Settings
VITE_MAX_UPLOAD_SIZE_MB=50
VITE_SUPPORTED_FORMATS=xlsx,xls

# ─────────────────────────────────────────────────────────────
# JDE / Tesorería — api.gruposenda.com (Producción)
# Endpoints:
#   POST /v1/erp/tesoreria/antiguedadsaldos
#   POST /v1/erp/tesoreria/bancos
#   GET  /v1/erp/tesoreria/empresas
# ─────────────────────────────────────────────────────────────
# Base URL consumida por el frontend. En dev dejar en /api/jde para
# que Vite haga proxy (evita CORS). En prod el rewrite lo maneja Vercel
# (ver vercel.json).
VITE_JDE_BASE_URL=/api/jde

# Host upstream al que Vite hará proxy en desarrollo. Solo se usa en
# vite.config.ts — no llega al bundle del frontend.
VITE_JDE_UPSTREAM=https://api.gruposenda.com/v1/erp/tesoreria

# Bearer token de autenticación para los APIs de JDE / Tesorería.
# NO commitear el token real — guardarlo en .env.local (ignorado por git).
VITE_JDE_TOKEN=PON_AQUI_TU_BEARER_TOKEN
