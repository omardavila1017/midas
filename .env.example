# Midas - local dev environment template
# Copy to `.env.local` and fill with local-only values. Never commit real
# credentials, bearer tokens, passwords, or API keys.

# ============================================================
# JDE (JD Edwards) - Orchestrator Framework
# ============================================================
VITE_JDE_BASE_URL=/api/jde
JDE_UPSTREAM=https://api.example.internal/JDEdwards
VITE_JDE_UPSTREAM=https://api.example.internal/JDEdwards

# Server-side only in Atlas/backend. Do not prefix production secrets with VITE_.
JDE_TOKEN=<server-side-jde-token>
# Optional local-dev fallback for Vite proxy only. Never set in production.
VITE_JDE_TOKEN=<local-dev-jde-token>

# Environment del JDE (PD920=prod, PY920=test, DV920=dev)
VITE_JDE_ENVIRONMENT=DV920

# ============================================================
# TRESS (Nomina) - namespace upstream /TRESS/Nomina
# Comparte token con JDE.
# ============================================================
VITE_TRESS_BASE_URL=/api/tress
TRESS_UPSTREAM=https://api.example.internal/TRESS
VITE_TRESS_UPSTREAM=https://api.example.internal/TRESS

# ============================================================
# CITI / Rol diario - browser calls /api/citi; backend injects CITI_TOKEN/JDE_TOKEN.
# ============================================================
VITE_CITI_BASE_URL=/api/citi
CITI_UPSTREAM=https://api.example.internal/CITI
VITE_CITI_UPSTREAM=https://api.example.internal/CITI
CITI_TOKEN=<server-side-citi-token>

# ============================================================
# Cognos - browser calls /api/cognos; backend injects COGNOS_TOKEN.
# ============================================================
VITE_COGNOS_BASE_URL=/api/cognos
COGNOS_UPSTREAM=https://cognos.example.internal
VITE_COGNOS_UPSTREAM=https://cognos.example.internal
COGNOS_TOKEN=<server-side-cognos-token>
VITE_COGNOS_TOKEN=<local-dev-cognos-token>
VITE_COGNOS_NAMESPACE=CognosEx

# ============================================================
# Auth
# ============================================================
# Midas uses /api/auth/* for real authentication. The backend must issue an
# HttpOnly, Secure, SameSite=Lax (or stricter) session cookie and handle
# password hashing, reset tokens, expiration, rate limiting, and email delivery.
# The browser must never receive password values through VITE_* variables.
#
# Base URL of the auth backend. Defaults to /api/auth, but the auth service may
# live on a different path/host (SSO, dedicated auth server), so it is
# configurable. authApi.ts hits ${VITE_AUTH_BASE_URL}/session, /login,
# /password/change, etc. with credentials:'include'. Set this to wherever the
# real auth backend is reachable (must allow the session cookie to flow back).
VITE_AUTH_BASE_URL=/api/auth
#
# LOCAL AUTH MODE (dev / internal). When src/config/authLocalUsers.json has
# "enabled": true, authApi.ts ignores the backend above and validates logins
# against that JSON (passwords stored as a SHA-256 hash, NOT plaintext). This is
# NOT a security boundary — the bundle is public — so never put real secrets
# there. Set "enabled": false in the JSON to fall back to VITE_AUTH_BASE_URL.

# ============================================================
# MIDAS AI (OpenAI)
# ============================================================
VITE_OPENAI_BASE_URL=/api/openai
OPENAI_UPSTREAM=https://api.openai.com/v1
OPENAI_API_KEY=<server-side-openai-key>
VITE_OPENAI_MODEL=gpt-4o-mini

# ============================================================
# RBAC — control de acceso por roles
# ============================================================
# Mapeo correo:rol (CSV: "email:rol" separados por coma). NO poner correos
# reales aquí — los reales viven solo en `.env` (ignorado por git).
# Roles válidos: admin | abastos | contaduria | fiscal | cobranza | mesa_ayuda
VITE_USER_ROLES="usuario@ejemplo.com:admin,otro@ejemplo.com:cobranza"
# Rol por defecto si el correo logueado no está en la lista (recomendado: none = sin acceso).
VITE_DEFAULT_ROLE="none"
# DEV ONLY: solo PRE-LLENA el campo de correo del login (conveniencia). No
# salta el login ni auto-autentica.
VITE_CURRENT_USER_EMAIL="usuario@ejemplo.com"
