# Midas API Configuration
# Copy this file to .env.local for local development.
# Configure these variables in Atlas/Vercel before deploying.
#
# IMPORTANTE — modelo de secretos:
#   * Variables con prefijo VITE_*  → quedan EMBEBIDAS en el bundle del
#     navegador. NO uses VITE_ para credenciales sensibles en producción.
#     Solo úsalas en desarrollo local (.env.local).
#   * Variables sin prefijo (ej. JDE_TOKEN, COGNOS_TOKEN) → permanecen
#     server-side y solo las leen las Vercel Functions / proxies. Esta es
#     la forma correcta de mover Bearer tokens al runtime de producción.

# ============================================================
# Atlas
# ============================================================
VITE_ATLAS_ARTIFACT_ID=midas

# ============================================================
# JDE (JD Edwards) — Orchestrator Framework
# ============================================================
# Base URL consumed by the frontend. En desarrollo el proxy de Vite
# reescribe /api/jde → JDE_UPSTREAM. En producción la Serverless Function
# `api/jde/[...path].ts` resuelve la llamada e inyecta JDE_TOKEN
# server-side, así el navegador nunca ve la credencial.
#
# Endpoints liberados en producción:
#   POST /antiguedadsaldos  → CXP / aging
#   POST /bancos            → Estados de cuenta
#   GET  /empresas          → Catálogo de compañías
#   POST /cobranza          → Cobranza (CXC) — liberado 2026-05-01
VITE_JDE_BASE_URL=/api/jde

# Upstream host. En dev lo lee Vite (vite.config.ts); en prod lo lee la
# Vercel Function. NO se inlinea en el bundle del cliente.
JDE_UPSTREAM=https://api.gruposenda.com/v1/erp/tesoreria
# Compat con configuraciones antiguas (sigue siendo solo dev/server-side).
VITE_JDE_UPSTREAM=https://api.gruposenda.com/v1/erp/tesoreria

# Solo dev: token Bearer para que `npm run dev` funcione apuntando al
# proxy de Vite. NO commitear el valor real — va en .env.local.
VITE_JDE_TOKEN=

# Producción / preview: token Bearer leído ÚNICAMENTE server-side por la
# Vercel Function. Configurar en Vercel Project → Settings → Env Vars
# (Environment: Production + Preview). NO replicar en VITE_JDE_TOKEN.
JDE_TOKEN=

# JDE environment code.
# Options: PD920 (production), PY920 (testing), DV920 (development)
VITE_JDE_ENVIRONMENT=DV920

# ============================================================
# Cognos BI — REST API
# ============================================================
# Base URL of the Cognos Analytics server.
VITE_COGNOS_BASE_URL=

# Cognos REST API authentication token.
# Mismo modelo que JDE: en producción usa COGNOS_TOKEN (server-side) a
# través de un proxy/Vercel Function dedicado. VITE_COGNOS_TOKEN es solo
# para desarrollo local.
VITE_COGNOS_TOKEN=
COGNOS_TOKEN=

# Cognos authentication namespace.
VITE_COGNOS_NAMESPACE=CognosEx

# ============================================================
# Login gate (cliente)
# ============================================================
# Password en texto plano de cada usuario. Este gate vive en cliente y solo
# disuade lecturas casuales — la auth real corre en Atlas SSO (ver AUTH.md).
VITE_ADMIN_PASSWORD=
VITE_PAOLO_PASSWORD=
