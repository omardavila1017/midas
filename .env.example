# FlowSense Environment Configuration
# Copy this file to .env.local and update with your values

# API Configuration (if needed in the future)
VITE_API_URL=http://localhost:3000

# Application Settings
VITE_MAX_UPLOAD_SIZE_MB=50
VITE_SUPPORTED_FORMATS=xlsx,xls

# ─────────────────────────────────────────────────────────────
# JD Edwards APIs (Antigüedad de Saldos, Bancos, Empresas)
# ─────────────────────────────────────────────────────────────
# Base URL consumida por el frontend. En desarrollo se deja en /api/jde
# para que Vite haga proxy al host interno (ver VITE_JDE_UPSTREAM).
# En producción, apuntar al host público cuando JDE lo publique.
VITE_JDE_BASE_URL=http://srv-desarrollo:90

# Host upstream al que Vite hará proxy en desarrollo.
# Solo se usa en vite.config.ts — no llega al bundle del frontend.
VITE_JDE_UPSTREAM=http://srv-desarrollo:90

# Bearer token de autenticación para los APIs de JDE.
# NO commitear el token real — guardarlo en .env.local (ignorado por git).
VITE_JDE_TOKEN=Smv9xKp2rNqLwA4jTdYe7BhCuZoV3mFgXi6nWsR
