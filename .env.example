# Midas API Configuration
# Copy this file to .env.local for local development.
#
# Solo se corre en localhost. Todas las variables VITE_* quedan EMBEBIDAS
# en el bundle del navegador, así que en este momento las credenciales JDE
# viajan en el cliente. Cuando se migre a un servidor con proxy real, los
# tokens deben volver a un namespace server-side.

# ============================================================
# Atlas
# ============================================================
VITE_ATLAS_ARTIFACT_ID=midas

# ============================================================
# JDE (JD Edwards) — Orchestrator Framework
# ============================================================
# Base URL que consume el frontend. El proxy de Vite (vite.config.ts)
# reescribe /api/jde → VITE_JDE_UPSTREAM para evitar CORS en dev.
#
# Endpoints liberados upstream:
#   POST /antiguedadsaldos  → CXP / aging
#   POST /bancos            → Estados de cuenta
#   GET  /empresas          → Catálogo de compañías
#   POST /cobranza          → Cobranza (CXC)
VITE_JDE_BASE_URL=/api/jde

# Upstream host que el proxy de Vite usa para reescribir /api/jde.
VITE_JDE_UPSTREAM=https://api.gruposenda.com/v1/erp/tesoreria

# Bearer token para JDE. Solo dev/local — al correr en localhost queda en el
# bundle. No commitear el valor real — va en .env.local.
VITE_JDE_TOKEN=

# JDE environment code.
# Options: PD920 (production), PY920 (testing), DV920 (development)
VITE_JDE_ENVIRONMENT=DV920

# ============================================================
# TRESS (Nómina) — namespace upstream /v1/erp/tress
# ============================================================
# Comparte token con JDE (VITE_JDE_TOKEN). El proxy de Vite reescribe
# /api/tress → VITE_TRESS_UPSTREAM.
VITE_TRESS_BASE_URL=/api/tress
VITE_TRESS_UPSTREAM=https://api.gruposenda.com/v1/erp/tress

# ============================================================
# Cognos BI — REST API
# ============================================================
VITE_COGNOS_BASE_URL=
VITE_COGNOS_TOKEN=
VITE_COGNOS_NAMESPACE=CognosEx

# ============================================================
# Login gate (cliente)
# ============================================================
# Password en texto plano de cada usuario. Este gate vive en cliente y solo
# disuade lecturas casuales — la auth real corre en Atlas SSO (ver AUTH.md).
VITE_ADMIN_PASSWORD=
VITE_PAOLO_PASSWORD=

# ============================================================
# MIDAS AI (OpenAI)
# ============================================================
# API key para el asistente MIDAS. AVISO: VITE_ se embebe en el bundle
# del cliente. En producción, migrar a un proxy server-side.
VITE_OPENAI_API_KEY=
# Modelo OpenAI (gpt-4o-mini, gpt-4o, gpt-4.1-mini, etc.)
VITE_OPENAI_MODEL=gpt-4o-mini
